{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AspApp.Controllers.ManagementController": "Information"
    }
  },
  "AllowedHosts": "*",

  "Turnstile": {
    "Enabled": false,
    "SecretKey": "your-secret-key"
  },

  "NATS": {
    "Url": "nats://nats:4222",
    "Subjects": {
      "CreateUserAccount": "userAccount.created",
      "DeleteUserAccount": "userAccount.deleted"
    },
    "Streams": {
      "UserAccount": "UserAccount"
    }
  },

  "Postgres": {
    "ConnectionString": {
      "Identity": "Host=postgres;Database=IdentityDb;Username=postgres;Password=Password;",
      "DataProtection": "Host=postgres;Database=DataProtectionDb;Username=postgres;Password=Password;"
    }
  },
  
  "GitHubClientId": "YourClientId",
  "GitHubClientSecret": "YourClientSecret",
  
  "GoogleClientId": "yourClientId.apps.googleusercontent.com",
  "GoogleClientSecret": "Your-Client-Secret",

  "Identity": {
    "AdminUserName": "adminUserName",
    "AdminPassword": "adminPassword",
    "AdminEmail": "adminEmail@email.com",
    "AdminRoleName": "Identity_Admins"
  },

  "EmailSender": {
    "Address": "yourEmailAddress@email.com",
    "Password": "your email password"
  }
  
}
